{
  "id": "heldout-upgrade-noop-when-current",
  "fixture": "empty",
  "phase": "upgrade",
  "classification": "upgrade",
  "candidateHosArea": ".hos/tools/lib/upgrade.mjs",
  "commands": [
    ["init", "--name", "Held Out Upgrade"],
    ["upgrade", "--from", "${source.path}"]
  ],
  "assertions": [
    { "type": "jsonField", "command": 1, "path": "applied", "equals": false },
    { "type": "jsonField", "command": 1, "path": "changes.add", "equals": 0, "expect": "an up-to-date install adds nothing (idempotent)" },
    { "type": "jsonField", "command": 1, "path": "changes.overwrite", "equals": 0 },
    { "type": "jsonField", "command": 1, "path": "changes.conflict", "equals": 0 }
  ]
}
