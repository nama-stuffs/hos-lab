{
  "id": "persona-workflow-gate",
  "fixture": "empty",
  "phase": "orchestration",
  "classification": "orchestration",
  "candidateHosArea": ".hos/tools/lib/workflow.mjs",
  "commands": [
    ["init", "--name", "Lab Workflow"],
    ["workflow", "start", "Protocol request", "--title", "Protocol workflow", "--acceptance", "protocol gate works", "--actor", "backend", "--level", "high"],
    ["workflow", "plan", "${command.1.ticket}", "--execute", "backend", "--verify", "rev+tester", "--evidence", "captured proof"],
    ["ticket", "move", "${command.1.ticket}", "reproduced"],
    ["compose", "backend+tester"],
    ["dispatch", "${command.1.ticket}", "--lenses", "backend", "--by", "worker-a"],
    ["run", "${command.1.ticket}", "--by", "backend", "--", "echo", "PROOF"],
    ["ticket", "move", "${command.1.ticket}", "fixed"],
    ["session", "open", "Verify the protocol gate"],
    ["dispatch", "${command.1.ticket}", "--lenses", "rev+tester", "--by", "verifier-a"],
    ["ticket", "verify", "${command.1.ticket}", "--result", "pass", "--by", "rev+tester", "--step", "s2", "--evidence", "run log"],
    ["ticket", "move", "${command.1.ticket}", "verified"],
    ["retro", "${command.1.ticket}", "--outcome", "no-op"],
    ["workflow", "lint", "${command.1.ticket}"],
    ["ticket", "create", "Bypass", "--acceptance", "cannot bypass", "--actor", "backend", "--level", "high"],
    {
      "args": ["ticket", "move", "${command.14.id}", "verified"],
      "allowFailure": true
    }
  ],
  "assertions": [
    { "type": "jsonField", "command": 1, "path": "session", "matches": "^S-" },
    { "type": "jsonField", "command": 1, "path": "ticket", "matches": "^T-" },
    { "type": "commandStdoutContains", "command": 4, "text": "Orchestration Protocol" },
    { "type": "commandStdoutContains", "command": 4, "text": "Testing Protocol" },
    { "type": "commandStdoutContains", "command": 5, "text": "Alpha plan" },
    { "type": "commandStdoutContains", "command": 5, "text": "session open" },
    { "type": "jsonField", "command": 11, "path": "status", "equals": "verified" },
    { "type": "jsonField", "command": 13, "path": "ok", "equals": true },
    { "type": "commandExit", "command": 15, "status": 1 },
    { "type": "commandStderrContains", "command": 15, "text": "workflow gate failed" }
  ]
}
